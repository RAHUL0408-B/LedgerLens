# Backend Environment Variables

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── AI Provider (pick ONE) ───────────────────────────────────────────────────
# Option A: Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Option B: OpenAI
# OPENAI_API_KEY=your-openai-api-key-here

# Active provider: "anthropic" | "openai"
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-haiku-20241022
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=30000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Reconciliation Policy ────────────────────────────────────────────────────
POLICY_HIGH_CONFIDENCE_THRESHOLD=0.95
POLICY_LOW_CONFIDENCE_THRESHOLD=0.75
POLICY_LOW_RISK_AMOUNT=10000
POLICY_HIGH_RISK_AMOUNT=100000
POLICY_DATE_TOLERANCE_DAYS=2

# ─── Razorpay (OPTIONAL — leave blank to use CSV only) ────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=50
