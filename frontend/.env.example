# Frontend Environment Variables

# ─── Backend API ──────────────────────────────────────────────────────────────
# Leave empty in development — Vite proxies /api to localhost:3001
# Set to your deployed backend URL in production
VITE_API_URL=

# ─── Supabase (public / anon key only — safe to expose) ──────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=LedgerLens
VITE_APP_VERSION=1.0.0

# IMPORTANT:
# NEVER put SUPABASE_SERVICE_ROLE_KEY here.
# NEVER put LLM_API_KEY here.
# NEVER put RAZORPAY_KEY_SECRET here.
# All secrets must live in backend/.env only.
