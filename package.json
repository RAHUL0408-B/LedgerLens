{
  "name": "ledgerlens",
  "version": "1.0.0",
  "description": "AI Finance Controller for payment reconciliation",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "install:all": "npm install",
    "generate-data": "npm run generate-data --workspace=backend",
    "evaluate": "npm run evaluate --workspace=backend",
    "benchmark": "npm run benchmark --workspace=backend",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
